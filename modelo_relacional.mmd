    %% Modelo relacional Medistock - esquema C##MEDISTOCK (Oracle XE 21c)
    %% PK: clave primaria. UK: clave unica. FK: clave foranea.
    %% Dos FK son constraints declaradas (detalle a pedidos, transacciones a cuentas);
    %% las demas son referencias logicas mantenidas por el paquete de sincronizacion.
    MED_USUARIOS ||--o{ MED_PEDIDOS : "realiza"
    MED_PEDIDOS ||--o{ MED_DETALLE_PEDIDOS : "contiene"
    MED_PRODUCTOS ||--o{ MED_DETALLE_PEDIDOS : "aparece en"
    MED_PRODUCTOS ||--o{ MED_HISTORIAL_STOCK : "historial"
    MED_PRODUCTOS ||--|| MED_ALERTAS_STOCK : "alerta 1:1"
    MED_CUENTAS_BANCARIAS ||--o{ MED_TRANSACCIONES_BANCARIAS : "origina"
    MED_TRANSACCIONES_BANCARIAS ||--o| MED_PEDIDOS : "paga"

    MED_PRODUCTOS {
        VARCHAR2 ID_PRODUCTO PK
        VARCHAR2 SKU UK
        VARCHAR2 NOMBRE
        VARCHAR2 DESCRIPCION
        NUMBER PRECIO
        VARCHAR2 CATEGORIA
        NUMBER STOCK
        NUMBER STOCK_MINIMO
        VARCHAR2 IMAGEN
    }

    MED_USUARIOS {
        VARCHAR2 ID_USUARIO PK
        VARCHAR2 NOMBRE
        VARCHAR2 CORREO UK
        VARCHAR2 ROL
        VARCHAR2 INSTITUCION
        VARCHAR2 HASH_CONTRASENA
    }

    MED_PEDIDOS {
        VARCHAR2 ID_PEDIDO PK
        VARCHAR2 ID_CLIENTE FK
        VARCHAR2 ESTADO
        NUMBER TOTAL
        TIMESTAMP FECHA_CREACION
        VARCHAR2 TIPO_PEDIDO
        VARCHAR2 MEDIO_PAGO
        VARCHAR2 ID_TRANSACCION FK
        VARCHAR2 FECHA_PAGO
    }

    MED_DETALLE_PEDIDOS {
        VARCHAR2 ID_PEDIDO PK,FK
        NUMBER NUMERO_LINEA PK
        VARCHAR2 ID_PRODUCTO FK
        NUMBER CANTIDAD
        NUMBER PRECIO_UNITARIO
    }

    MED_CUENTAS_BANCARIAS {
        VARCHAR2 ID_CUENTA PK
        NUMBER SALDO
        VARCHAR2 MONEDA
    }

    MED_TRANSACCIONES_BANCARIAS {
        VARCHAR2 ID_TRANSACCION PK
        VARCHAR2 ID_CUENTA FK
        VARCHAR2 TIPO_TRANSACCION
        NUMBER MONTO
        VARCHAR2 DESCRIPCION
        TIMESTAMP FECHA_TRANSACCION
        VARCHAR2 ESTADO
    }

    MED_ALERTAS_STOCK {
        VARCHAR2 ID_PRODUCTO PK
        VARCHAR2 SKU
        VARCHAR2 NOMBRE_PRODUCTO
        NUMBER STOCK
        NUMBER STOCK_MINIMO
        VARCHAR2 ESTADO
        TIMESTAMP FECHA_CREACION
        TIMESTAMP FECHA_ACTUALIZACION
    }

    MED_HISTORIAL_STOCK {
        NUMBER ID_CAMBIO PK
        VARCHAR2 ID_PRODUCTO FK
        VARCHAR2 SKU
        VARCHAR2 NOMBRE_PRODUCTO
        NUMBER STOCK_ANTERIOR
        NUMBER STOCK_NUEVO
        VARCHAR2 TIPO_CAMBIO
        TIMESTAMP FECHA_CAMBIO
    }